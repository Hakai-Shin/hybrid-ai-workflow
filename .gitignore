# Secrets — never commit
.env
secrets/
*.json.key
service-account*.json

# Java
enclave/target/
*.class
*.jar
!pom.xml

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Go
cloud/workers/*/vendor/

# Terraform state — use remote backend in production
