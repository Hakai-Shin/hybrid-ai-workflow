cloud/terraform/terraform.tfstate
cloud/terraform/terraform.tfstate.backup
cloud/terraform/*.tfvars

# Local data
data/raw/
data/enclave-db*

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db
